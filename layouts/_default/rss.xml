{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
  {{- $pages = $pctx.RegularPages -}}
{{- else -}}
  {{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" 
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:content="http://purl.org/rss/1.0/modules/content/"
  xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description | default (printf "Recent content on %s" .Site.Title) }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ .Site.LanguageCode }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    
    {{- range $pages }}
    {{- /* cover.hidden 僅控制網站顯示；RSS 仍提供封面給閱讀器。 */ -}}
    {{- $img := "" -}}
    {{- $page := . -}}
    {{- $coverExists := true -}}
    {{- with .Params.cover.image -}}
      {{- if and (hasPrefix . "/") (not (hasPrefix . "//")) -}}
        {{- $coverExists = fileExists (printf "static%s" .) -}}
      {{- else if and (not (hasPrefix . "/")) (not (hasPrefix . "http")) -}}
        {{- $coverExists = ne ($page.Resources.GetMatch .) nil -}}
      {{- end -}}
    {{- end -}}
    {{- if and .Params.cover.image $coverExists -}}
        {{- $coverImage := .Params.cover.image -}}
        {{- /* 檢查是否為相對路徑（不以 / 或 http 開頭） */ -}}
        {{- if and (not (hasPrefix $coverImage "/")) (not (hasPrefix $coverImage "http")) -}}
            {{- /* 相對路徑：組合文章的 Permalink + 圖片名稱 */ -}}
            {{- $img = printf "%s%s" .Permalink $coverImage -}}
        {{- else -}}
            {{- /* 絕對路徑或完整 URL：直接使用 absURL */ -}}
            {{- $img = $coverImage | absURL -}}
        {{- end -}}
    {{- else if .Params.images -}}
        {{- $img = (index .Params.images 0) | absURL -}}
    {{- else -}}
        {{- with site.Params.defaultImage -}}
          {{- $img = . | absURL -}}
        {{- end -}}
    {{- end -}}
    {{- $content := .Content | replaceRE `(?s)<script.*?</script>` "" | replaceRE `(?s)<style.*?</style>` "" -}}
    
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      
      {{- /* 提供閱讀器可辨識的媒體圖片。 */ -}}
      {{- if $img }}
      <media:content url="{{ $img }}" medium="image"/>
      {{- end }}
      
      <description>
        {{- /* 摘要也提供可見圖片，供不支援 Media RSS 的閱讀器使用。 */ -}}
        {{- if $img -}}
            {{- printf "<img src=\"%s\" alt=\"%s\" />" $img .Title | html -}}
        {{- end -}}
        {{- .Summary | html -}}
      </description>
      
      {{- if .Site.Params.ShowFullTextinRSS }}
      <content:encoded>
        {{- /* 內文中也確保有圖片 */ -}}
        {{- if $img -}}
            {{- printf "<p><img src=\"%s\" alt=\"%s\" /></p>" $img .Title | html -}}
        {{- end -}}
        {{- $content | html -}}
      </content:encoded>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
